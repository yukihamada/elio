/* InfoPlist.strings (German) */

"NSCalendarsUsageDescription" = "ElioChat liest und erstellt Kalenderereignisse, damit du die KI nach deinem Zeitplan fragen kannst. Sage zum Beispiel „Welche Termine habe ich heute?", um deine Ereignisse zu sehen.";
"NSContactsUsageDescription" = "ElioChat durchsucht deine Kontakte, wenn du die KI nach Personen fragst. Sage zum Beispiel „Was ist Tanakas Telefonnummer?", um Kontaktdaten nachzuschlagen.";
"NSPhotoLibraryUsageDescription" = "ElioChat greift auf deine Fotobibliothek zu, damit du Bilder zur Analyse mit der KI teilen kannst. Wähle zum Beispiel ein Foto aus und frage „Was ist auf diesem Bild?"";
"NSLocationWhenInUseUsageDescription" = "ElioChat verwendet deinen aktuellen Standort, um standortbezogene Fragen zu beantworten. Frage zum Beispiel „Wo bin ich gerade?", um deine Adresse zu erfahren.";
"NSRemindersUsageDescription" = "ElioChat liest und erstellt Erinnerungen über KI-Gespräche. Sage zum Beispiel „Erinnere mich um 10 Uhr an den Müll", um eine neue Erinnerung zu erstellen.";
"NSCameraUsageDescription" = "ElioChat verwendet die Kamera, um Fotos zur KI-Analyse aufzunehmen. Fotografiere zum Beispiel ein Dokument und bitte die KI, es zusammenzufassen.";
"NSMicrophoneUsageDescription" = "ElioChat verwendet das Mikrofon, um Sprachnachrichten aufzunehmen und Sprache in Text umzuwandeln. Tippe zum Beispiel auf die Mikrofontaste, um eine Nachricht zu diktieren, anstatt zu tippen.";
"NSSpeechRecognitionUsageDescription" = "ElioChat verwendet die geräteinterne Spracherkennung, um deine Stimme in Text für KI-Gespräche umzuwandeln. Sprich zum Beispiel natürlich und sieh, wie deine Worte als getippte Nachricht erscheinen.";
"NSPhotoLibraryAddUsageDescription" = "ElioChat speichert KI-generierte Bilder in deiner Fotobibliothek. Wenn die KI zum Beispiel ein Bild erstellt, kannst du auf Speichern tippen, um es in Fotos zu sichern.";
"NSLocalNetworkUsageDescription" = "ElioChat verwendet das lokale Netzwerk, um sich mit Geräten in der Nähe zu verbinden und KI-Inferenz zu teilen. Teile zum Beispiel die Rechenleistung mit einem anderen ElioChat-Gerät im selben WLAN.";
