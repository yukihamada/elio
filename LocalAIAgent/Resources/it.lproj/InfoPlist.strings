/* InfoPlist.strings (Italian) */

"NSCalendarsUsageDescription" = "ElioChat legge e crea eventi del calendario per permetterti di chiedere all'IA della tua agenda. Ad esempio, chiedi \"Quali riunioni ho oggi?\" per vedere i tuoi prossimi eventi.";
"NSContactsUsageDescription" = "ElioChat cerca nei tuoi contatti quando chiedi all'IA informazioni su persone. Ad esempio, chiedi \"Qual è il numero di Tanaka?\" per trovare i dettagli del contatto.";
"NSPhotoLibraryUsageDescription" = "ElioChat accede alla tua libreria foto per condividere immagini con l'IA per l'analisi. Ad esempio, seleziona una foto e chiedi \"Cosa c'è in questa immagine?\"";
"NSLocationWhenInUseUsageDescription" = "ElioChat usa la tua posizione attuale per rispondere a domande basate sulla posizione. Ad esempio, chiedi \"Dove sono adesso?\" per ottenere il tuo indirizzo.";
"NSRemindersUsageDescription" = "ElioChat legge e crea promemoria tramite conversazione con l'IA. Ad esempio, dì \"Ricordami di portare fuori la spazzatura alle 10\" per creare un nuovo promemoria.";
"NSCameraUsageDescription" = "ElioChat usa la fotocamera per scattare foto da analizzare con l'IA. Ad esempio, fotografa un documento e chiedi all'IA di riassumerlo.";
"NSMicrophoneUsageDescription" = "ElioChat usa il microfono per registrare messaggi vocali e convertire il parlato in testo nelle conversazioni. Ad esempio, tocca il pulsante del microfono per dettare un messaggio invece di digitare.";
"NSSpeechRecognitionUsageDescription" = "ElioChat usa il riconoscimento vocale del dispositivo per convertire la tua voce in testo per le conversazioni con l'IA. Ad esempio, parla naturalmente e vedi le tue parole apparire come testo digitato.";
"NSPhotoLibraryAddUsageDescription" = "ElioChat salva le immagini generate dall'IA nella tua libreria foto. Ad esempio, quando l'IA crea un'immagine, tocca Salva per archiviarla in Foto.";
"NSLocalNetworkUsageDescription" = "ElioChat usa la rete locale per connettersi ai dispositivi vicini e condividere l'inferenza IA. Ad esempio, condividi la potenza di calcolo con un altro dispositivo ElioChat sulla stessa rete Wi-Fi.";
