/* InfoPlist.strings (Korean) */

"NSCalendarsUsageDescription" = "ElioChat이 캘린더 일정을 읽고 생성하여 AI에게 일정을 물어볼 수 있습니다. 예를 들어 \"오늘 회의가 뭐 있어?\"라고 물으면 다가오는 일정을 보여줍니다.";
"NSContactsUsageDescription" = "ElioChat이 AI에게 사람에 대해 물어볼 때 연락처를 검색합니다. 예를 들어 \"다나카 전화번호가 뭐야?\"라고 물으면 연락처 정보를 찾아줍니다.";
"NSPhotoLibraryUsageDescription" = "ElioChat이 사진 라이브러리에 접근하여 AI에 이미지를 공유하고 분석합니다. 예를 들어 사진을 선택하고 \"이 사진에 뭐가 있어?\"라고 물어볼 수 있습니다.";
"NSLocationWhenInUseUsageDescription" = "ElioChat이 현재 위치를 사용하여 위치 기반 질문에 답합니다. 예를 들어 \"지금 어디야?\"라고 물으면 현재 주소를 알려줍니다.";
"NSRemindersUsageDescription" = "ElioChat이 AI 대화를 통해 미리 알림을 읽고 생성합니다. 예를 들어 \"내일 10시에 쓰레기 버리기 알려줘\"라고 하면 새 미리 알림을 만듭니다.";
"NSCameraUsageDescription" = "ElioChat이 카메라로 사진을 촬영하여 AI가 분석합니다. 예를 들어 문서를 촬영하고 AI에게 요약을 요청할 수 있습니다.";
"NSMicrophoneUsageDescription" = "ElioChat이 마이크를 사용하여 음성 메시지를 녹음하고 대화 중 음성을 텍스트로 변환합니다. 예를 들어 마이크 버튼을 탭하여 타이핑 대신 음성으로 메시지를 보낼 수 있습니다.";
"NSSpeechRecognitionUsageDescription" = "ElioChat이 기기의 음성 인식을 사용하여 AI 대화를 위해 음성을 텍스트로 변환합니다. 예를 들어 자연스럽게 말하면 입력된 텍스트로 나타납니다.";
"NSPhotoLibraryAddUsageDescription" = "ElioChat이 AI가 생성한 이미지를 사진 라이브러리에 저장합니다. 예를 들어 AI가 이미지를 만들면 저장을 탭하여 사진에 보관할 수 있습니다.";
"NSLocalNetworkUsageDescription" = "ElioChat이 근처 기기와 연결하여 AI 추론을 공유합니다. 예를 들어 같은 Wi-Fi에 있는 다른 ElioChat 기기와 처리 능력을 공유할 수 있습니다.";
